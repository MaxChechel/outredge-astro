---
/**
 * Text for screen readers only (§4.1).
 *
 * Wraps the `sr-only` utility so intent is legible in markup and there is one
 * place to change the technique if it ever needs to.
 */
interface Props {
  /** `span` inside a phrase, `div` around block content. */
  as?: 'span' | 'div';
  class?: string;
}

const { as = 'span', class: className } = Astro.props as Props;
---

{
  as === 'div' ? (
    <div class:list={['sr-only', className]}><slot /></div>
  ) : (
    <span class:list={['sr-only', className]}><slot /></span>
  )
}
