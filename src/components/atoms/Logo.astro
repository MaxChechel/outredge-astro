  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 119 16"
  fill="none"
  class:list={['h-auto w-full', className]}
  role={title ? 'img' : 'presentation'}
  aria-label={title}
  aria-hidden={title ? undefined : 'true'}
