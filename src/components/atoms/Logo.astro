---
/**
 * The wordmark (§4.1). PROJECT: replace.
 *
 * This repo's own mark. A client project swaps the path data for its own,
 * exported from Figma and run through `svgoOptimizer()` (see astro.config.mjs),
 * keeping the `currentColor` fills — that is what lets the mark follow
 * `--text-primary` under any theme, and it is why the mark is inlined rather
 * than referenced as `<img src="…svg">`: an <img> is a separate document, so
 * `currentColor` inside it would resolve against its own root.
 *
 * No `width` attribute and no fixed height: the caller sizes it, normally with
 * `w-nav-logo`. A wordmark pinned to a height is a wordmark that breaks the nav
 * rhythm the moment someone swaps in a mark with a different aspect ratio.
 *
 * `title` gives the mark an accessible name. Omit it inside a link that already
 * names itself, or the link gets announced twice.
 */
interface Props {
  class?: string;
  title?: string;
}

const { class: className, title } = Astro.props as Props;
---

