---
import { canonicalUrl, canonicalPath } from '../../lib/urls';
import { SITE, isNoindexed } from '../../consts';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import JsonLd from '../atoms/JsonLd.astro';
import '../../styles/global.css';

/**
 * The page shell (§4.3).
 *
 * Owns <head>, the skip-link target, and the canonical/og normalization that
 * `build.format: 'file'` makes necessary (src/lib/urls.ts).
 */
interface Props {
  title: string;
  description?: string;
  /** Root-relative path to the share image. */
  ogImage?: string;
  /**
   * Force noindex. Routes listed in SITE.noindex are noindexed without this —
   * stated once in consts.ts and consumed here and by the sitemap, so the two
   * cannot drift.
   */
  noindex?: boolean;
  /** Renders without the site chrome. */
  bare?: boolean;
  /**
   * What KIND of page this is, for the page node in the structured data.
   * schema.org's page types are a closed list, and this union is the subset the
   * site has pages for: a string would let a typo ship a type nothing
   * recognises, silently, because structured data has no runtime.
   * PROJECT: extend as page kinds land (AboutPage, CollectionPage, …).
   */
  pageType?: 'WebPage' | 'ContactPage';
}

const {
  title,
  description = SITE.description,
  ogImage,
  noindex = false,
  bare = false,
  pageType = 'WebPage',
} = Astro.props as Props;

const canonical = canonicalUrl(Astro.url.pathname, Astro.site);
const path = canonicalPath(Astro.url.pathname);
const isNoindex = noindex || isNoindexed(path);
const ogImageAbsolute = ogImage ? new URL(ogImage, Astro.site).href : undefined;

/**
 * SITE-WIDE STRUCTURED DATA — one `@graph`, not three blocks.
 *
 * The organisation publishes the site, and the page is part of the site; the
 * nodes reference each other by `@id`, and a graph is how that is said once.
 * Three unlinked blocks would describe three unrelated things that happen to
 * share a page.
 *
 * EVERY VALUE IS SOMETHING THE SITE ALREADY SAYS. No address, telephone,
 * `sameAs` or founding date unless the page publishes them: structured data is
 * the wrong place to debut a fact nobody can check against the page, and it
 * reads as authoritative precisely because a machine wrote it. And no
 * `SearchAction` on a site without search — it names an endpoint that 404s.
 *
 * A breadcrumb trail, when a project has one, is emitted by the component that
 * draws the visible trail, from the same array, so the two cannot drift.
 */
const ORG_ID = `${SITE.origin}/#organization`;
const SITE_ID = `${SITE.origin}/#website`;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': ORG_ID,
      name: SITE.name,
      url: SITE.origin,
      description: SITE.description,
      logo: {
        '@type': 'ImageObject',
        url: new URL('/apple-touch-icon.png', SITE.origin).href,
        width: 180,
        height: 180,
      },
    },
    {
      '@type': 'WebSite',
      '@id': SITE_ID,
      url: SITE.origin,
      name: SITE.name,
      description: SITE.description,
      publisher: { '@id': ORG_ID },
      inLanguage: SITE.locale,
    },
    {
      '@type': pageType,
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: title,
      ...(description && { description }),
      isPartOf: { '@id': SITE_ID },
      inLanguage: SITE.locale,
      ...(ogImageAbsolute && { primaryImageOfPage: ogImageAbsolute }),
    },
  ],
};
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    {isNoindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    {
      ogImageAbsolute && (
        <>
          <meta property="og:image" content={ogImageAbsolute} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta name="twitter:card" content="summary_large_image" />
        </>
      )
    }

    {/* PROJECT: <Font cssVariable="--font-body" preload /> once astro.config.mjs
        declares a face. Until then --font-sans falls through to system-ui. */}

    {/* Generated by scripts/build-icons.mjs from src/assets/brand/icon.svg.
        `sizes="32x32"` on the ICO is load-bearing: without it a browser may
        rank the ICO as the better candidate and never read the SVG, which is
        the one that answers the OS colour scheme. */}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <JsonLd schema={structuredData} />
  </head>

  <body>
    {!bare && <Nav />}

    {/* id="main" is the skip link's real target. A skip link that points at an
         id no page has is the most common a11y bug there is. */}
    <main id="main">
      <slot />
    </main>

    {!bare && <Footer />}
  </body>
</html>
