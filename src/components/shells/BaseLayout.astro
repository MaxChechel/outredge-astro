---
import { canonicalUrl } from '../../lib/urls';
import { site } from '../../data/navigation';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import '../../styles/global.css';

/**
 * The page shell (§4.3).
 *
 * Owns <head>, the skip-link target, and the canonical/og normalization that
 * `build.format: 'file'` makes necessary (src/lib/urls.ts).
 */
interface Props {
  title: string;
  description?: string;
  /** Root-relative path to the share image. */
  ogImage?: string;
  /** Set on pages that should not be indexed — the styleguide, for one. */
  noindex?: boolean;
  /** Renders without the site chrome. */
  bare?: boolean;
}

const { title, description = site.description, ogImage, noindex = false, bare = false } =
  Astro.props as Props;

const canonical = canonicalUrl(Astro.url.pathname, Astro.site);
const ogImageAbsolute = ogImage ? new URL(ogImage, Astro.site).href : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    {
      ogImageAbsolute && (
        <>
          <meta property="og:image" content={ogImageAbsolute} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta name="twitter:card" content="summary_large_image" />
        </>
      )
    }

    {/* PROJECT: <Font cssVariable="--font-body" preload /> once astro.config.mjs
        declares a face. Until then --font-sans falls through to system-ui. */}

    {/* PROJECT: favicons. Nothing loose in public/ except these and the OG image. */}
  </head>

  <body>
    {!bare && <Nav />}

    <!-- id="main" is the skip link's real target. A skip link that points at an
         id no page has is the most common a11y bug there is. -->
    <main id="main">
      <slot />
    </main>

    {!bare && <Footer />}
  </body>
</html>
