---
/**
 * /styleguide — the system's visual test surface.
 *
 * ENV-GATED. The filename is underscore-prefixed so Astro does not route it;
 * astro.config.mjs injects the route only for `astro dev` and for a build run
 * with INCLUDE_STYLEGUIDE=1. A production build emits nothing for it — not a
 * noindex page, not an orphan HTML file, nothing.
 *
 * This page is deliberately the densest thing the system will ever render: every
 * token, every component, both themes, at once. That is the point — it is what
 * `npm run verify` is pointed at, so a regression anywhere in the system shows
 * up on one page rather than on whichever client page happened to use the
 * broken thing.
 */
import cssSource from '../styles/global.css?raw';
import BaseLayout from '../components/shells/BaseLayout.astro';
import Section from '../components/Section.astro';
import Button from '../components/atoms/Button.astro';
import TextLink from '../components/atoms/TextLink.astro';
import FormField from '../components/atoms/FormField.astro';
import Logo from '../components/atoms/Logo.astro';
import VisuallyHidden from '../components/atoms/VisuallyHidden.astro';
import JsonLd from '../components/atoms/JsonLd.astro';
import SectionHeader from '../components/blocks/SectionHeader.astro';
import Faq from '../components/blocks/Faq.astro';
import CtaBanner from '../components/blocks/CtaBanner.astro';
import LogoStrip from '../components/blocks/LogoStrip.astro';
import ItemCard from '../components/blocks/ItemCard.astro';
import { getItems, getItemBody } from '../lib/items';
import * as vocabulary from '../components/mdx';
import {
  parseThemeScopes,
  textMatrix,
  accentMatrix,
  lineMatrix,
  resolveColor,
  contrastRatio,
  AA,
} from '../../scripts/verify/lib/contrast.mjs';

/* The matrix below is COMPUTED, at build time, from the same global.css the page
   is styled by — and by the same module scripts/verify/contrast.mjs uses against
   the built CSS. Hand-written ratios in a styleguide go stale the first time
   someone nudges a primitive, and a stale ratio is worse than no ratio.
 *
 * `?raw` rather than readFileSync: the frontmatter is bundled before it runs, so
 * `import.meta.url` points at a chunk in dist/.prerender/ and the relative path
 * resolves to nothing. A `?raw` import is inlined by Vite at build time, which
 * is the only way to read a source file from a component that will be bundled. */
const scopes = parseThemeScopes(cssSource);
const text = textMatrix(scopes);
const accent = accentMatrix(scopes);
const lines = lineMatrix(scopes);
const textFailures = text.filter((r) => !r.pass).length;

const themes = ['light', 'dark'] as const;
const BACKGROUNDS = ['--bg-base', '--bg-subtle', '--bg-surface'] as const;
const TEXTS = ['--text-primary', '--text-secondary', '--text-tertiary'] as const;
const cell = (theme: string, bg: string, t: string) =>
  text.find((r) => r.theme === theme && r.bg === bg && r.text === t)!;

/* Primitive ramp, read out of the same file.
 *
 * The step label's colour is CHOSEN PER SWATCH by the same contrast function the
 * matrix uses — whichever of black or white clears AA against that swatch. The
 * obvious alternative, white text under `mix-blend-mode: difference`, is what
 * this page shipped first: it looks fine, axe cannot evaluate it at all, and on
 * the mid-ramp it genuinely fails. A styleguide that demonstrates the contrast
 * rule must not break it in its own furniture. */
const ramp = [...scopes.root.keys()]
  .filter((k) => /^--gray-\d+$/.test(k))
  .map((k) => {
    const value = scopes.root.get(k)!;
    const onBlack = contrastRatio('#000000', value);
    const onWhite = contrastRatio('#ffffff', value);
    return {
      name: k,
      value,
      step: Number(k.replace('--gray-', '')),
      label: onBlack >= onWhite ? '#000000' : '#ffffff',
      labelRatio: Math.max(onBlack, onWhite),
    };
  })
  .sort((a, b) => a.step - b.step);
/* If this ever throws, a swatch is so mid-grey that neither black nor white
   clears AA on it — which is a ramp problem, not a label problem. */
const rampLabelFloor = Math.min(...ramp.map((r) => r.labelRatio));
if (rampLabelFloor < AA) {
  throw new Error(`Ramp swatch labels cannot clear AA: floor is ${rampLabelFloor.toFixed(2)}:1`);
}

const accents = [
  { name: '--accent-500', value: scopes.root.get('--accent-500')!, note: 'light theme' },
  { name: '--accent-300', value: scopes.root.get('--accent-300')!, note: 'dark theme' },
];

const SEMANTIC_ROLES: Record<string, string> = {
  '--bg-base': 'page ground',
  '--bg-subtle': 'secondary ground',
  '--bg-surface': 'cards / raised',
  '--text-primary': 'text · headings & body',
  '--text-secondary': 'text · supporting',
  '--text-tertiary': 'text · meta & captions',
  '--accent': 'accent · text, fill, border',
  '--accent-contrast': 'the only legal text on accent',
  '--line': 'dividers & card edges',
  '--line-strong': 'interactive control boundary',
};
const semanticTokens = Object.keys(SEMANTIC_ROLES);

/* The type scale. One token per role, one class per role — there is no bare
   `text-<size>` utility in the system to show alongside them (§1b). */
const TYPE_ROLES = [
  { token: '--text-h1', style: 'text-h1', note: '36 → 64px', sample: 'Heading one' },
  { token: '--text-h2', style: 'text-h2', note: '32 → 48px', sample: 'Heading two' },
  { token: '--text-h3', style: 'text-h3', note: '28 → 38px', sample: 'Heading three' },
  { token: '--text-h4', style: 'text-h4', note: '24 → 30px', sample: 'Heading four' },
  { token: '--text-h5', style: 'text-h5', note: '20 → 24px', sample: 'Heading five' },
  { token: '--text-h6', style: 'text-h6', note: '18 → 20px', sample: 'Heading six' },
  { token: '--text-large', style: 'text-large', note: '18 → 20px', sample: 'Lede — the opening paragraph.' },
  { token: '--text-body', style: 'text-body', note: '16 → 17px', sample: 'Body — the default reading size.' },
  { token: '--text-sm', style: 'text-sm', note: '14 → 15px', sample: 'Small body — dense UI copy.' },
  { token: '--text-caption', style: 'text-caption', note: '14 → 15px', sample: 'Caption — figure captions, meta.' },
  { token: '--text-eyebrow', style: 'text-eyebrow', note: '12 → 13px', sample: 'Eyebrow label' },
];

/* Every form control, in every state worth seeing. Declared rather than written
   out three times: the point of the grid is that the three columns are the SAME
   markup with one prop different, so a state that only looks right because it was
   hand-tuned has nowhere to hide. */
const FORM_STATES = [
  { key: 'normal', label: 'normal', error: undefined, disabled: false },
  {
    key: 'error',
    label: 'error — aria-invalid + aria-describedby',
    error: 'That does not look right.',
    disabled: false,
  },
  { key: 'disabled', label: 'disabled — how every form ships (§8)', error: undefined, disabled: true },
] as const;

const BUDGETS = ['Under £10k', '£10k – £25k', '£25k – £50k', '£50k+'];

const SPACING_STEPS = ['3xs', '2xs', 'xs', 'sm', 'md', 'lg', 'xl', '2xl', '3xl', '4xl'];
const SECTION_STEPS = ['section-sm', 'section-md', 'section-lg', 'nav'];

const faqItems = [
  {
    question: 'Why native <details> rather than an accordion script?',
    answer: [
      'It is keyboard-operable, announced as a disclosure, and findable by in-page search, with zero JavaScript.',
      'The open/close is still spring-eased — through ::details-content, which is the only box in a <details> that can be transitioned.',
    ],
  },
  {
    question: 'Why is the card not a component?',
    answer: [
      'Because the cards a project ships share no structure — different elements, different internal grids, different interaction. A common parent would be a bordered div, which is a class, not a component.',
    ],
  },
];

const demoLogos = [
  { name: 'Mark One', slug: 'mark-one' },
  { name: 'Mark Two', slug: 'mark-two' },
  { name: 'Mark Three', slug: 'mark-three' },
];

const items = await getItems();
/* A real MDX body, rendered with the §4.5 vocabulary, so the components in
   src/components/mdx/ are exercised by the harness rather than only shipped. */
const { Content: ItemBody } = await getItemBody('item-one');

const INDEX = [
  ['01', 'color', 'Colour tokens'],
  ['02', 'contrast', 'Contrast matrix'],
  ['03', 'type', 'Type scale'],
  ['04', 'spacing', 'Spacing scale'],
  ['05', 'layout', 'Layout & gutters'],
  ['06', 'section', 'Section'],
  ['07', 'atoms', 'Atoms'],
  ['08', 'blocks', 'Blocks & the card pattern'],
  ['09', 'nav', 'Nav dropdown'],
  ['10', 'motion', 'Motion'],
  ['11', 'prose', 'Prose'],
  ['12', 'collection', 'Demo collection'],
];
---

<BaseLayout title="Styleguide · outredge-system" description="Every token and component in the system, annotated." noindex>
  <!-- ===================================================================
       HEADER
       =================================================================== -->
  <Section as="header" spaceTop="nav" spaceBottom="lg">
    <div class="gap-2xl flex flex-col">
      <div class="gap-md flex flex-wrap items-end justify-between">
        <div class="gap-sm flex flex-col">
          <h1 class="text-h1">Styleguide</h1>
          <p class="sg-meta">outredge-system · internal · env-gated out of production builds</p>
        </div>
        <p class="sg-meta">
          contrast matrix: {text.length}/{text.length - textFailures} passing at {AA}:1
        </p>
      </div>
    </div>
  </Section>

  <!-- ===================================================================
       INDEX — sticks under the nav once it reaches it.

       A full-bleed band rather than something inside the header Section: a
       `sticky` element only sticks within its own parent, so an index nested in
       a short header would scroll away with it. As a direct child of <main> its
       parent is the whole page, which is the length it needs to stay put for.

       `top-nav` is the nav's own height token, so the two bars meet exactly and
       keep meeting if the nav height ever changes.
       =================================================================== -->
  <div class="border-line bg-surface top-nav sticky z-30 border-b">
    <nav aria-label="Styleguide sections" class="container-main py-sm">
      <ul class="list-bare gap-x-md gap-y-2xs flex flex-wrap">
        {
          INDEX.map(([num, id, label]) => (
            <li>
              <a href={`#${id}`} class="sg-index-link">
                <span class="sg-mono">{num}</span> {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <!-- ===================================================================
       01 COLOUR
       =================================================================== -->
  <Section id="color" space="md">
    <div class="gap-lg flex flex-col">
      <SectionHeader
        eyebrow="01 · colour"
        heading="Colour tokens"
        lede="Primitives are not a vocabulary — they are not in the --color-* namespace, so bg-gray-500 does not compile. The semantic layer below is the only thing components touch, and each token is exposed by one @utility in its legal role only."
        split
      />

      <div class="gap-sm flex flex-col">
        <p class="sg-meta">
          Primitive ramp — even CIE L* steps, constant low cool chroma.
          <strong class="text-primary">PROJECT: replace.</strong> The retheme checklist greps for that marker.
        </p>
        <ul class="border-line list-bare grid grid-cols-5 overflow-hidden rounded-md border md:grid-cols-15">
          {
            ramp.map((swatch) => (
              <li class="sg-swatch" style={`background:${swatch.value}`}>
                <span class="sg-swatch-label" style={`color:${swatch.label}`}>{swatch.step}</span>
              </li>
            ))
          }
        </ul>
        <ul class="list-bare gap-sm flex flex-wrap">
          {
            accents.map((a) => (
              <li class="border-line gap-xs px-sm py-xs flex items-center rounded-sm border">
                <span class="sg-chip" style={`background:${a.value}`} />
                <span class="sg-mono">{a.name}</span>
                <span class="sg-meta">{a.value} · {a.note}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Side-by-side theme panels. IDENTICAL MARKUP; only [data-theme] differs. -->
      <div class="gap-md grid md:grid-cols-2">
        {
          themes.map((theme) => (
            <div data-theme={theme} class="bg-base border-line p-md gap-sm flex flex-col rounded-md border">
              <p class="sg-meta">
                {theme === 'light' ? '[data-theme] absent → light' : '[data-theme="dark"] → designed, not inverted'}
              </p>
              <ul class="list-bare gap-2xs flex flex-col">
                {semanticTokens.map((token) => (
                  <li class="bg-surface border-line gap-x-sm gap-y-3xs px-sm py-xs flex flex-wrap items-center rounded-sm border">
                    <span class="sg-chip border-line border" style={`background:${resolveColor(scopes, theme, token)}`} />
                    <span class="sg-mono grow whitespace-nowrap">{token}</span>
                    <span class="sg-meta grow text-right">{SEMANTIC_ROLES[token]}</span>
                  </li>
                ))}
              </ul>
              <p class="sg-meta">
                Grounds ascend on dark — base → subtle → surface — because there is no perceptual room below a
                near-black page ground. Surface is lighter than base in <em>both</em> themes; it is subtle's
                direction that flips.
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </Section>

  <!-- ===================================================================
       02 CONTRAST MATRIX
       =================================================================== -->
  <Section id="contrast" space="md" class="bg-subtle">
    <div class="gap-lg flex flex-col">
      <SectionHeader
        eyebrow="02 · contrast"
        heading="Contrast matrix — enforced by verify"
        lede="Every text token on every background in every theme. Computed at build time from global.css by the same module npm run verify runs against dist — hand-written ratios go stale the first time someone nudges a primitive."
        split
      />

      <div class="gap-md grid lg:grid-cols-2">
        {
          themes.map((theme) => (
            <div data-theme={theme} class="bg-base border-line p-md gap-sm flex flex-col rounded-md border">
              <p class="sg-meta">
                {theme} · 9 pairs · floor{' '}
                {Math.min(...text.filter((r) => r.theme === theme).map((r) => r.ratio)).toFixed(2)}:1
              </p>
              <div class="overflow-x-auto" tabindex="0" role="region" aria-label={`${theme} theme contrast matrix`}>
                <table class="sg-matrix">
                  <thead>
                    <tr>
                      <th scope="col"><VisuallyHidden>Text token</VisuallyHidden></th>
                      {BACKGROUNDS.map((bg) => <th scope="col">{bg.replace('--bg-', '')}</th>)}
                    </tr>
                  </thead>
                  <tbody>
                    {TEXTS.map((t) => (
                      <tr>
                        <th scope="row">{t.replace('--text-', '')}</th>
                        {BACKGROUNDS.map((bg) => {
                          const r = cell(theme, bg, t);
                          return (
                            <td style={`background:${r.bgHex};color:${r.textHex}`}>
                              <span class="sg-matrix-sample">Aa</span>
                              <span class="sg-matrix-ratio">
                                {r.ratio.toFixed(2)} {r.pass ? '✓' : '✕'}
                              </span>
                            </td>
                          );
                        })}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          ))
        }
      </div>

      <div class="gap-md grid md:grid-cols-2">
        <div class="bg-surface border-line p-md gap-xs flex flex-col rounded-md border">
          <p class="sg-meta">Accent group · {accent.length} pairs, {accent.filter((r) => !r.pass).length} failing</p>
          <ul class="list-bare gap-3xs flex flex-col">
            {
              accent.map((r) => (
                <li class="sg-mono gap-sm flex items-baseline justify-between">
                  <span>{r.theme} · {r.text.replace('--', '')} on {r.bg.replace('--', '')}</span>
                  <span class={r.pass ? 'text-secondary' : 'text-accent'}>{r.ratio.toFixed(2)}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="bg-surface border-line p-md gap-xs flex flex-col rounded-md border">
          <p class="sg-meta">
            Line group · {lines.length} pairs. <code>--line</code> is decorative and only has to be seen;
            <code> --line-strong</code> is a control boundary and carries WCAG 1.4.11's 3:1.
          </p>
          <ul class="list-bare gap-3xs flex flex-col">
            {
              lines
                .filter((r) => r.threshold !== null)
                .map((r) => (
                  <li class="sg-mono gap-sm flex items-baseline justify-between">
                    <span>{r.theme} · line-strong on {r.bg.replace('--bg-', '')}</span>
                    <span class={r.pass ? 'text-secondary' : 'text-accent'}>{r.ratio.toFixed(2)}</span>
                  </li>
                ))
            }
          </ul>
        </div>
      </div>
    </div>
  </Section>

  <!-- ===================================================================
       03 TYPE
       =================================================================== -->
  <Section id="type" space="md">
    <div class="gap-lg flex flex-col">
      <SectionHeader
        eyebrow="03 · type"
        heading="Type scale"
        lede="One token per role, one class per role, and no bare text-<size> utility to fall back to — the scale is not in @theme, so an element either wears a named style or inherits one. Every step is a clamp() between a 320px and a 1312px viewport; there are no media queries in the type system at all."
        split
      />

      <ul class="list-bare flex flex-col">
        {
          TYPE_ROLES.map(({ token, style, note, sample }) => (
            <li class="border-line gap-3xs py-sm flex flex-col border-t">
              <p class="sg-meta">
                <span class="sg-mono">{token}</span> · <span class="sg-mono">.{style}</span> · {note}
              </p>
              <p class={style}>{sample}</p>
            </li>
          ))
        }
      </ul>

      <div class="bg-surface border-line p-md gap-xs flex flex-col rounded-md border">
        <h3 class="text-h6 text-primary">Size is still decoupled from level</h3>
        <p class="text-sm text-secondary measure">
          Naming the tokens for their roles does not re-couple them: the decoupling lives in the CLASS, which any
          element may wear. An <span class="sg-mono">&lt;h2 class="text-h4"&gt;</span> is correct and ordinary —
          the outline is a semantics decision, the size is a design one, and a component takes the level as a prop
          so the two never have to agree.
        </p>
        <p class="sg-meta measure">
          Below: an <span class="sg-mono">&lt;h4&gt;</span> wearing <span class="sg-mono">.text-h2</span>, and an
          <span class="sg-mono">&lt;h3&gt;</span> wearing <span class="sg-mono">.text-caption</span>. The sweep
          enforces one h1 and zero skips; it does not care what size anything is.
        </p>
        <h4 class="text-h2 text-primary">An h4 at h2 size</h4>
        <h4 class="text-caption text-tertiary">An h4 at caption size</h4>
      </div>
    </div>
  </Section>

  <!-- ===================================================================
       04 SPACING
       =================================================================== -->
  <Section id="spacing" space="md" class="bg-subtle">
    <div class="gap-lg flex flex-col">
      <SectionHeader
        eyebrow="04 · spacing"
        heading="Spacing scale"
        lede="Fluid throughout, from a 2px hairline to 12rem. The bars are live token widths at this viewport — resize and they move. T-shirt names permanently: a numeric name would collide with stock Tailwind's meaning in every developer's memory, and the failure is silent in both directions."
        split
      />

      <ul class="list-bare gap-2xs flex flex-col">
        {
          SPACING_STEPS.map((step) => (
            <li class="gap-md grid grid-cols-[6rem_1fr] items-center">
              <span class="sg-mono">--spacing-{step}</span>
              <span class="sg-bar" style={`width: var(--spacing-${step})`} />
            </li>
          ))
        }
      </ul>

      <div class="gap-2xs flex flex-col">
        <p class="sg-meta">Section rhythm and nav clearance — consumed only by &lt;Section&gt;, never by a page.</p>
        <ul class="list-bare gap-2xs flex flex-col">
          {
            SECTION_STEPS.map((step) => (
              <li class="gap-md grid grid-cols-[9rem_1fr] items-center">
                <span class="sg-mono">--spacing-{step}</span>
                <span class="sg-bar" style={`width: var(--spacing-${step})`} />
              </li>
            ))
          }
        </ul>
        <p class="sg-meta measure">
          <span class="sg-mono">--spacing-section-nav</span> is derived, never measured:
          <span class="sg-mono">calc(var(--nav-height) + var(--spacing-section-md))</span>. It stays correct when
          either input moves.
        </p>
      </div>
    </div>
  </Section>

  <!-- ===================================================================
       05 LAYOUT & GUTTERS  (full-bleed, so the rules line up with the real page)
       =================================================================== -->
  <Section id="layout" space="md" width="full">
    <div class="container-main">
      <SectionHeader
        eyebrow="05 · layout"
        heading="Site margin, container, and the one gutter"
        lede="--site-margin is the only source of page-edge inline padding in the system. Nav, Section and Footer all read it through the same container utility, which is what makes a logo, a heading and a footer link land on one vertical line down the page edge."
        split
      />
    </div>

    <!-- The demo is full-bleed on purpose: the dashed rules below sit at exactly
         the same x as the container edge of every other section on this page.
         Compare them against the heading above. -->
    <div class="mt-lg border-line relative border-y">
      <div class="sg-gutter-overlay" aria-hidden="true">
        <div class="container-main h-full">
          <div class="sg-gutter-rule h-full"></div>
        </div>
      </div>

      <div class="border-line border-b">
        <div class="container-main h-nav gap-md flex items-center justify-between">
          <Logo class="w-nav-logo text-primary" title="Nav logo" />
          <span class="sg-meta">Nav — container-main</span>
        </div>
      </div>

      <div class="py-lg">
        <div class="container-main gap-2xs flex flex-col">
          <p class="text-h6 text-primary">Section — container-main</p>
          <p class="sg-meta">Same max-width, same --site-margin. Children never re-apply either.</p>
        </div>
      </div>

      <div class="bg-subtle border-line py-sm border-y text-center">
        <p class="sg-meta">
          width="full" — the wrapper is kept so theme and rhythm are identical; only the max-width and the site
          margin are skipped. Full bleed is a container variant, not a different component.
        </p>
      </div>

      <div class="border-line border-t">
        <div class="container-main h-nav flex items-center">
          <span class="sg-meta">Footer — container-main</span>
        </div>
      </div>
    </div>

    <div class="container-main mt-lg">
      <div class="bg-surface border-line p-md gap-xs flex flex-col rounded-md border">
        <h3 class="text-h6 text-primary">The boundary below Section</h3>
        <ul class="list-bare gap-3xs text-sm text-secondary flex flex-col">
          <li>— no <code>max-w-container-*</code>: the token is outside <code>@theme</code>, so the utility does not exist.</li>
          <li>— no <code>px-*</code> recreating gutters: <code>--site-margin</code> is applied once, by the container.</li>
          <li>— no <code>py-*</code> recreating section rhythm: that is <code>space</code>.</li>
          <li>— no <code>mx-auto</code> page centering.</li>
        </ul>
        <p class="sg-meta">
          Anything that must exceed its container is a Section-level decision — <code>width="full"</code>, or a new
          ruling. A "breakout" width is deliberately not in the system.
        </p>
      </div>
    </div>
  </Section>

  <!-- ===================================================================
       06 SECTION
       =================================================================== -->
  <Section id="section" space="md" class="bg-subtle">
    <div class="gap-lg flex flex-col">
      <SectionHeader
        eyebrow="06 · section"
        heading="Section — the page grammar"
        lede="The only page-level parent. It alone applies vertical padding, the container and the theme. Hatching below is the padding Section owns; pages never make a spacing decision and there is no such thing as a spacer div."
        split
      />

      <div class="gap-md grid sm:grid-cols-2 lg:grid-cols-4">
        <div class="gap-2xs flex flex-col">
          <div class="sg-diagram">
            <div class="sg-pad" style="height: var(--spacing-section-sm)"><span class="sg-pad-label">space=sm</span></div>
            <div class="sg-diagram-content">content</div>
            <div class="sg-pad" style="height: var(--spacing-section-sm)"></div>
          </div>
          <p class="sg-meta">space="sm" — symmetric</p>
        </div>

        <div class="gap-2xs flex flex-col">
          <div class="sg-diagram">
