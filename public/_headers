# Cloudflare Pages response headers.
#
# PROJECT: the CSP below is the one this system ships with. Adding a third-party
# script, font, or embed means widening it HERE, deliberately, and saying why —
# not discovering at launch that the console is full of blocked requests.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # 'unsafe-inline' for script-src, and why it is not a nonce: Astro inlines
  # small modules into the HTML, and Pages serves static files — it cannot vary a
  # nonce per response, so a nonce here would be a constant, which is not a
  # nonce. The mitigation is the JS census (§6): every inline module in dist is
  # named and budgeted by `npm run verify`, so "inline script" is an enumerated
  # set rather than an open door.
  # challenges.cloudflare.com is Turnstile, used by the contact form only.
  # Admitted ahead of the env var that switches it on, so the deploy that sets
  # PUBLIC_TURNSTILE_SITE_KEY does not also need this file edited.
  #
  # Nothing else is admitted ahead of need. `npm run verify` reads this line
  # against the production builds, per directive, both ways: anything the site
  # loads must be admitted here, and anything admitted here must be loaded. So a
  # video CDN behind VIDEO_BASE adds its origin to media-src — the build will
  # say so — and `data:` returns to img-src the day something uses it.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; media-src 'self'; connect-src 'self'; frame-src https://challenges.cloudflare.com; base-uri 'none'; form-action 'self'; frame-ancestors 'none'

# Fingerprinted assets are immutable: the filename changes when the content does.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# HTML revalidates, so a deploy is visible immediately.
/*.html
  Cache-Control: public, max-age=0, must-revalidate
